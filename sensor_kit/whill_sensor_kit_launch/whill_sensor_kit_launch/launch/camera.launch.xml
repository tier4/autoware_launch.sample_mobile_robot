<launch>
 <group>
    <push-ros-namespace namespace="camera"/>
    
    <node pkg="video_receiver" exec="video_receiver" name="rtp_video_receiver_node" output="log">
      <param name="ip" value="10.42.0.100"/>
      <param name="port" value="5004"/>
      <param name="topic" value="camera0/image_raw"/>
      <param name="frame_id" value="camera0/camera_optical_link"/>
      <param name="width" value="1920"/>
      <param name="height" value="1280"/>
      <param name="timestamp_config" value="1"/>
    </node>

    <include file="$(find-pkg-share camera_info_publisher)/launch/camera_info_publisher.launch.xml">
      <arg name="camera_name" value="camera0"/>
      <arg name="camera_info_file" value="$(find-pkg-share whill_sensor_kit_launch)/data/camera0_info.yaml"/>
    </include>

    <node pkg="image_proc" exec="rectify_node" name="rectify_node" output="log">
      <remap from="camera_info" to="camera0/camera_info"/>
      <remap from="image" to="camera0/image_raw"/>
      <remap from="image_rect" to="camera0/image_rect_color"/>
      <remap from="image_rect/compressed" to="camera0/image_rect_color/compressed"/>
      <remap from="image_rect/compressedDepth" to="camera0/image_rect_color/compressedDepth"/>
      <remap from="image_rect/theora" to="camera0/image_rect_color/theora"/>
    </node>
  </group>
</launch>
